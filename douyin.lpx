#!name = Skip Proxy And Real-IP Lists (With Douyin MiniProgram)
#!desc = 跳过部分应用的代理检测 + 抖音/小程序直连
#!author = mieqq & modified
#!system = iOS, iPadOS, macOS
#!loon_version = 3.3.2(877)
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Apple.png
#!homepage = https://github.com/Tartarus2014/Loon-Script

[General]
# 原有国内银行/服务直连 + 新增抖音系/小程序域名（逗号分隔，支持通配符）
skip-proxy = www.baidu.com,yunbusiness.ccb.com,wxh.wo.cn,gate.lagou.com,www.abchina.com.cn,www.shanbay.com,login-service.mobile-bank.psbc.com,mobile-bank.psbc.com,id6.me,*.douyin.com,*.snssdk.com,*.byteimg.com,*.bytesmanager.com,*.amemv.com,*.ixigua.com,*.toutiao.com

# 返回真实IP（原有 + 抖音系防止一键登录/SDK异常）
real-ip = easy-login.10099.com.cn,*-update.xoyocdn.com,id6.me,open.e.189.cn,*.douyin.com,*.snssdk.com

# 若开启 TUN 模式，需同步绕过（防止 TUN 强制接管流量）
bypass-tun = 192.168.0.0/16, 10.0.0.0/8, 127.0.0.0/8, *.douyin.com, *.snssdk.com, *.byteimg.com, *.bytesmanager.com, *.amemv.com

[Rule]
# 原有拦截规则
DOMAIN, msmp.abchina.com.cn, REJECT

# 抖音/小程序核心域名强制直连（防止被全局代理/规则覆盖）
DOMAIN-SUFFIX, douyin.com, DIRECT
DOMAIN-SUFFIX, snssdk.com, DIRECT
DOMAIN-SUFFIX, byteimg.com, DIRECT
DOMAIN-SUFFIX, bytesmanager.com, DIRECT
DOMAIN-SUFFIX, amemv.com, DIRECT
DOMAIN-SUFFIX, ixigua.com, DIRECT
DOMAIN-SUFFIX, toutiao.com, DIRECT

# （可选）屏蔽抖音常见数据上报/广告埋点（不需要可删除）
# DOMAIN, log.snssdk.com, REJECT
# DOMAIN, monitor.snssdk.com, REJECT
# DOMAIN, api.amemv.com, REJECT

[MitM]
# 不可MitM也不应该被打断连接的域名（保留原 TestFlight + 新增抖音系）
hostname = -testflight.apple.com, -*.douyin.com, -*.snssdk.com
